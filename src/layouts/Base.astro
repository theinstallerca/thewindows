---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Custom PVC windows fabricated in Winnipeg, Manitoba. Measured, built and installed by The Windows.' } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/windows', label: 'Windows' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · The Windows</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar-inner">
        <a href="tel:+12040000000">Tel (204) 000-0000</a>
        <div class="topbar-links">
          <a href="/contact">Contact</a>
          <a href="https://theinstaller.ca" rel="noopener">Commercial glazing</a>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="The Windows home">
          <img src="/logo.svg" alt="thewindows" height="34" />
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
        <nav id="nav" class="nav">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href="/contact" class="nav-cta">Get a quote</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <img src="/logo.svg" alt="thewindows" height="30" />
          <p style="margin-top: 0.8rem;">Custom PVC windows fabricated and installed in Winnipeg, Manitoba.</p>
        </div>
        <div>
          <h4>Site</h4>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h4>Contact</h4>
          <ul>
            <li><a href="mailto:info@thewindows.ca">info@thewindows.ca</a></li>
            <li><a href="tel:+12040000000">(204) 000-0000</a></li>
            <li>Mon–Fri 8:00–17:00</li>
          </ul>
        </div>
        <div>
          <h4>Commercial</h4>
          <ul>
            <li>Storefront and curtain wall projects are handled by our partner company.</li>
            <li><a href="https://theinstaller.ca" rel="noopener">theinstaller.ca →</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} The Windows</span>
        <span>Winnipeg, Manitoba</span>
      </div>
    </footer>

    <script>
      const btn = document.querySelector('.nav-toggle');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const open = nav!.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
