---
import '../styles/global.css';
import logo from '../assets/logo-light.svg';
import { t, link, phone, type Lang } from '../i18n';
import Email from '../components/Email.astro';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  path: string; // page path without language prefix, e.g. '/windows'
  /** breadcrumb trail after Home, as [label, path] pairs, for search results */
  crumbs?: [string, string][];
  /** picture shown when the page is shared (path under /public); defaults to the site card */
  image?: string;
  /** keep this page out of search results (e.g. the not-found page) */
  noindex?: boolean;
}
const { title, lang = 'en', path, crumbs, noindex } = Astro.props;
const s = t(lang);
const description = Astro.props.description ?? s.meta.description;
const nav = [
  { href: link(lang, '/'), label: s.nav.home },
  { href: link(lang, '/windows'), label: s.nav.windows },
  { href: link(lang, '/gallery'), label: s.nav.gallery },
  { href: link(lang, '/about'), label: s.nav.about },
  { href: link(lang, '/contact'), label: s.nav.contact },
];
const footNav = [...nav, { href: link(lang, '/estimate'), label: s.nav.estimate }];
const norm = (u: string) => u.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const current = norm(Astro.url.pathname);
const enUrl = link('en', path);
const ukUrl = link('uk', path);
const site = 'https://thewindows.ca';
const canonical = site + link(lang, path);
const shareImage = site + (Astro.props.image ?? '/images/share.jpg');
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': site + '/#business',
  name: 'TheWindows',
  description: s.meta.description,
  url: site + '/',
  telephone: phone.tel,
  image: site + '/images/share.jpg',
  logo: site + '/apple-touch-icon.png',
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '17:00' }],
  address: { '@type': 'PostalAddress', addressLocality: 'Winnipeg', addressRegion: 'MB', addressCountry: 'CA' },
  areaServed: [{ '@type': 'City', name: 'Winnipeg' }, { '@type': 'AdministrativeArea', name: 'Manitoba' }],
  knowsLanguage: ['en', 'uk'],
  makesOffer: (['casement', 'awning', 'picture', 'fixed'] as const).map((k) => ({ '@type': 'Offer', // 'Service', not 'Product': Google treats a Product as for sale and then demands a price, reviews or a rating
  itemOffered: { '@type': 'Service', serviceType: (s.types as any)[k][0], name: (s.types as any)[k][0], description: (s.types as any)[k][1], areaServed: 'Winnipeg, Manitoba' } })),
};
const breadcrumbs = crumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [[s.nav.home, '/'] as [string, string], ...crumbs].map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: site + link(lang, p) })),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · TheWindows</title>
    <meta name="description" content={description} />
    {!noindex && <>
      <link rel="alternate" hreflang="en" href={`https://thewindows.ca${enUrl}`} />
      <link rel="alternate" hreflang="uk" href={`https://thewindows.ca${ukUrl}`} />
      <link rel="alternate" hreflang="x-default" href={`https://thewindows.ca${enUrl}`} />
      <link rel="canonical" href={canonical} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TheWindows" />
    <meta property="og:title" content={`${title} · TheWindows`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_CA'} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar-inner">
        <a href={`tel:${phone.tel}`}>{s.top.tel} {phone.display}</a>
        <div class="topbar-links">
          <a href="https://theinstaller.ca" rel="noopener" class="ti-top" aria-label={`Theinstaller: ${s.top.commercial}`} title={s.top.commercial}><img src="/images/theinstaller-logo.png" alt="theinstaller" width="489" height="96" /></a>
          <span class="langs">
            <a href={enUrl} class={lang === 'en' ? 'active' : ''} aria-label="English" title="English" hreflang="en">
              <svg viewBox="0 0 60 30" width="18" height="12" preserveAspectRatio="none" aria-hidden="true"><clipPath id="uk-clip"><path d="M0 0v30h60V0z"/></clipPath><path d="M0 0v30h60V0z" fill="#012169"/><path d="M0 0l60 30m0-30L0 30" stroke="#fff" stroke-width="6"/><path d="M0 0l60 30m0-30L0 30" clip-path="url(#uk-clip)" stroke="#C8102E" stroke-width="4"/><path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/></svg>
            </a>
            <a href={ukUrl} class={lang === 'uk' ? 'active' : ''} aria-label="Українська" title="Українська" hreflang="uk">
              <svg viewBox="0 0 60 30" width="18" height="12" preserveAspectRatio="none" aria-hidden="true"><rect width="60" height="15" fill="#0057B7"/><rect y="15" width="60" height="15" fill="#FFD700"/></svg>
            </a>
          </span>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <a href={link(lang, '/')} class="brand" aria-label="TheWindows home">
          <img src={logo.src} alt="thewindows" width="381" height="52" />
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
        <nav id="nav" class="nav">
          {nav.map((n) => (
            <a href={n.href} draggable="false" aria-current={current === norm(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
          <a href={link(lang, '/contact')} class="nav-cta">{s.nav.quote}</a>
          <span class="langs langs-mobile">
            <a href={enUrl} class={lang === 'en' ? 'active' : ''}>EN</a>
            <a href={ukUrl} class={lang === 'uk' ? 'active' : ''}>UA</a>
          </span>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <img src={logo.src} alt="thewindows" width="249" height="34" />
          <p style="margin-top: 0.8rem;">{s.footer.blurb}</p>
        </div>
        <div>
          <p class="foot-h">{s.footer.site}</p>
          <ul>
            {footNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="foot-h">{s.footer.contact}</p>
          <ul>
            <li><Email lang={lang} /></li>
            <li><a href={`tel:${phone.tel}`}>{phone.display}</a></li>
            <li>{s.footer.hours}</li>
          </ul>
        </div>
        <div>
          <a href="https://theinstaller.ca" rel="noopener" class="ti-foot">
            <img src="/images/theinstaller-logo.png" alt="theinstaller" width="489" height="96" loading="lazy" />
            <span>{s.top.commercial}</span>
          </a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} TheWindows</span>
        <span>{s.footer.city}</span>
      </div>
    </footer>

    <script>
      // Email links: the address is put together only after a real visitor does something (see Email.astro).
      const wake = ['pointermove', 'pointerdown', 'touchstart', 'keydown', 'scroll'];
      const reveal = () => {
        wake.forEach((ev) => removeEventListener(ev, reveal));
        document.querySelectorAll<HTMLAnchorElement>('a.eml').forEach((a) => {
          const addr = a.dataset.u + String.fromCharCode(64) + a.dataset.d;
          a.href = 'mai' + 'lto:' + addr;
          a.textContent = addr;
        });
      };
      wake.forEach((ev) => addEventListener(ev, reveal, { passive: true }));

      const btn = document.querySelector('.nav-toggle');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const open = nav!.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      });
      // Navigate on pointer release anywhere inside a menu item (more robust than relying on the browser's native link hit-test).
      nav?.addEventListener('pointerup', (e) => {
        const a = (e.target as HTMLElement).closest('a');
        if (!a || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        if (a.target === '_blank') return;
        e.preventDefault();
        window.location.href = a.href;
      });
    </script>
  </body>
</html>
