---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Custom PVC windows fabricated in Winnipeg, Manitoba. Measured, built and installed by The Windows.' } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/windows', label: 'Windows' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · The Windows</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="The Windows home">
          <img src="/logo.svg" alt="" width="36" height="36" />
          <span>The Windows</span>
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
        <nav id="nav" class="nav">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href="/contact" class="btn btn-primary nav-cta">Get a quote</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>The Windows</strong>
          <p>PVC window fabrication<br />Winnipeg, Manitoba</p>
        </div>
        <div>
          <strong>Contact</strong>
          <p>
            <a href="mailto:info@thewindows.ca">info@thewindows.ca</a><br />
            <a href="tel:+12040000000">(204) 000-0000</a>
          </p>
        </div>
        <div>
          <strong>Hours</strong>
          <p>Mon–Fri 8:00–17:00<br />Sat by appointment</p>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} The Windows. All rights reserved.</span>
      </div>
    </footer>

    <script>
      const btn = document.querySelector('.nav-toggle');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
