---
import Base from '../layouts/Base.astro';
import WindowArt from '../components/WindowArt.astro';
const types = [
  { kind: 'casement', name: 'Casement', text: 'Hinged on the side and cranks open outward. Best seal of any opening window — ideal for bedrooms and living rooms.' },
  { kind: 'awning', name: 'Awning', text: 'Hinged at the top, opens outward from the bottom. Can stay open in the rain; common above picture windows and in basements.' },
  { kind: 'slider', name: 'Slider', text: 'One sash slides horizontally past the other. Economical and easy to operate; a good fit for wide openings.' },
  { kind: 'hung', name: 'Single / double hung', text: 'Sashes move vertically. A classic look for older Winnipeg homes.' },
  { kind: 'picture', name: 'Picture (fixed)', text: 'Does not open. Maximum glass, maximum insulation value — often combined with casements or awnings on the sides.' },
  { kind: 'tilt', name: 'Tilt & turn', text: 'European style: tilts inward from the top for ventilation, or swings fully open for cleaning and egress.' },
] as const;
---
<Base title="Window Types">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1 class="center">Window types</h1>
        <p>All windows are made from multi-chamber PVC profile with steel reinforcement, fusion-welded corners and sealed insulated glass units. Any type can be combined into a larger assembly.</p>
      </div>
      <div class="cards">
        {types.map((t) => (
          <article class="card">
            <div class="media"><WindowArt kind={t.kind} /></div>
            <div class="body"><h3>{t.name}</h3><p>{t.text}</p></div>
            <div class="foot"><a href="/contact" class="btn">+ Quote</a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container split" style="align-items: start;">
      <div>
        <h2>Glass</h2>
        <ul class="checklist">
          <li>Double or triple pane sealed units</li>
          <li>Low-E coatings, argon fill</li>
          <li>Warm-edge spacer bars</li>
          <li>Tempered glass where code requires it</li>
          <li>Obscure / frosted glass for bathrooms</li>
          <li>Internal grilles in several patterns</li>
        </ul>
      </div>
      <div>
        <h2>Frame &amp; hardware</h2>
        <ul class="checklist">
          <li>White, or laminated exterior colours and woodgrains</li>
          <li>Multi-point locking hardware</li>
          <li>Integrated screens</li>
          <li>Brickmould, jamb extensions and nailing fin to suit your wall</li>
          <li>Custom sizes and shapes</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="container">
      <h2>Not sure which type suits your opening?</h2>
      <p>We'll recommend the right combination during the measurement visit.</p>
      <a href="/contact" class="btn btn-light">Book a free measurement</a>
    </div>
  </section>
</Base>
