---
import Base from '../layouts/Base.astro';
import WindowArt from '../components/WindowArt.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Custom PVC Windows, Made in Winnipeg">
  <section class="hero">
    <div class="hero-bg"><WindowArt kind="hero" /></div>
    <div class="container hero-inner">
      <h1><small>Made in Winnipeg</small>Windows that change<br />how a house feels</h1>
      <p>Custom PVC windows, measured and fabricated in our own shop and installed by the same crew.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-light">Request a quote</a>
        <a href="/windows" class="more" style="padding: 0.7rem 0; color: #fff;">+ Window types</a>
      </div>
    </div>
  </section>

  <div class="strip">
    <ul>
      <li><Icon name="sun" /> Light</li>
      <li><Icon name="shield" /> Security</li>
      <li><Icon name="quiet" /> Quiet</li>
      <li><Icon name="snow" /> Warmth</li>
      <li><Icon name="leaf" /> Savings</li>
    </ul>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Built here, for here</h2>
        <p>A small shop that controls every step — from the first measurement to the last bead of sealant.</p>
      </div>
      <div class="values">
        <div class="value">
          <Icon name="ruler" /><span class="bar"></span>
          <h3>Made to measure</h3>
          <p>Every unit is built to your exact opening, so installation is clean and tight with nothing to hide.</p>
        </div>
        <div class="value">
          <Icon name="snow" /><span class="bar"></span>
          <h3>Rated for −40</h3>
          <p>Multi-chamber PVC profiles, steel reinforcement and warm-edge double or triple glazing for Manitoba winters.</p>
        </div>
        <div class="value">
          <Icon name="clock" /><span class="bar"></span>
          <h3>Short lead times</h3>
          <p>Fabricated locally, so most orders are ready in weeks, and service is a short drive away.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <h2>Window types</h2>
        <p>Any type can be combined into a larger assembly for your opening.</p>
      </div>
      <div class="cards">
        <article class="card">
          <div class="media"><WindowArt kind="casement" /></div>
          <div class="body"><h3>Casement</h3><p>Side-hinged, cranks outward. The tightest seal of any opening window.</p></div>
          <div class="foot"><a href="/windows" class="btn">+ info</a></div>
        </article>
        <article class="card">
          <div class="media"><WindowArt kind="tilt" /></div>
          <div class="body"><h3>Tilt &amp; turn</h3><p>European style: tilts in for ventilation or swings fully open for cleaning.</p></div>
          <div class="foot"><a href="/windows" class="btn">+ info</a></div>
        </article>
        <article class="card">
          <div class="media"><WindowArt kind="picture" /></div>
          <div class="body"><h3>Picture &amp; combinations</h3><p>Fixed glass for maximum light, paired with awnings or casements on the sides.</p></div>
          <div class="foot"><a href="/windows" class="btn">+ info</a></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="media"><WindowArt kind="corner" /></div>
      <div>
        <h2>The details that matter</h2>
        <p>Fusion-welded corners, steel-reinforced frames, multi-point locks and sealed glass units with warm-edge spacers. We choose profiles and glass for this climate, not for a catalogue.</p>
        <ul class="checklist">
          <li>Double or triple pane, Low-E, argon fill</li>
          <li>White or laminated exterior colours and woodgrains</li>
          <li>Integrated screens and internal grilles</li>
          <li>Brickmould, jamb extensions and nailing fin to suit your wall</li>
        </ul>
        <a href="/windows" class="more">+ Options and glass</a>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head"><h2>How it works</h2></div>
      <ol class="steps">
        <li><span class="num">01</span><h3>Measure</h3><p>Free visit — we measure every opening and talk through options.</p></li>
        <li><span class="num">02</span><h3>Quote</h3><p>A clear written price per window. No surprises.</p></li>
        <li><span class="num">03</span><h3>Fabricate</h3><p>Cut, welded, glazed and tested in our Winnipeg shop.</p></li>
        <li><span class="num">04</span><h3>Install</h3><p>Old units out, new ones in, insulated, sealed and cleaned up.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="container">
      <h2>Ready to replace your windows?</h2>
      <p>Tell us a bit about your house and we'll get back to you within one business day.</p>
      <a href="/contact" class="btn btn-light">Request a quote</a>
    </div>
  </section>
</Base>
