---
// A cut through the edge of a unit, drawn from the real profile outlines (src/data/profiles.json,
// millimetres). Exterior is on the left; the glass runs off the bottom of the drawing.
// Outlines are the profiles' outer contours; the position of the bead and glass in the casement and
// fixed sections is worked out from the picture unit's, so this is an illustration, not a shop drawing.
import data from '../data/profiles.json';
interface Props { kind: 'casement' | 'awning' | 'picture' | 'fixed'; labels: { ext: string; int: string; depth: string; sight: string; parts: string[] }; }
const { kind, labels } = Astro.props;
type Pt = [number, number];
const P = data as Record<string, { outline: Pt[]; seals: Pt[][] }>;
const sashed = kind === 'casement' || kind === 'awning';
const frameKey = sashed ? 'R8543' : kind === 'picture' ? 'R8544' : 'R8545';
// where the glass and the bead sit, from the frame's exterior face (x) and outer edge (y)
const G = sashed ? { front: 21.9, edge: 62.9, sight: 77.8, beadX: 48.9 } : kind === 'picture' ? { front: 21.8, edge: 26.7, sight: 41.6, beadX: 48.8 } : { front: 17.7, edge: 62.7, sight: 77.6, beadX: 44.7 };
const path = (pts: Pt[], dx = 0, dy = 0) => 'M' + pts.map(([x, y]) => `${(x + dx).toFixed(1)} ${(y + dy).toFixed(1)}`).join('L') + 'Z';
const parts: { d: string; seal?: boolean }[] = [];
const add = (key: string, dx = 0, dy = 0) => { parts.push({ d: path(P[key].outline, dx, dy) }); P[key].seals.forEach((s) => parts.push({ d: path(s, dx, dy), seal: true })); };
add(frameKey);
if (sashed) add('GP333', 4.6, 19.4);
add('GP358', G.beadX, G.sight - 20.9);
const gEnd = G.sight + 40;
const lites = [0, 15.5, 31].map((o) => ({ x: G.front + o, y: G.edge, w: 3, h: gEnd - G.edge }));
const inch = (mm: number) => { const s = Math.round(mm / 25.4 * 16); const w = Math.floor(s / 16), f = s % 16; const g = (a: number, b: number): number => (b ? g(b, a % b) : a); const d = f ? g(f, 16) : 1; return (w ? w : '') + (w && f ? ' ' : '') + (f ? `${f / d}/${16 / d}` : '') + '"'; };
// numbered markers: frame, sash (if any), glass, bead
const marks = [
  { n: 1, x: sashed ? 60 : 34, y: sashed ? 12 : 9 },
  ...(sashed ? [{ n: 2, x: 30, y: 48 }] : []),
  { n: sashed ? 3 : 2, x: G.front + 17, y: G.sight + 26 },
  { n: sashed ? 4 : 3, x: G.beadX + 12, y: G.sight - 8 },
];
---
<figure class="psec">
  <svg viewBox={`-26 -22 134 ${gEnd + 34}`} role="img" aria-label={labels.depth} font-family="JetBrains Mono, monospace" font-size="4.2">
    {lites.map((l) => <rect x={l.x} y={l.y} width={l.w} height={l.h} fill="rgba(160,190,210,.35)" stroke="#9fb4c2" stroke-width="0.3" />)}
    <rect x={G.front + 3} y={G.edge} width="12.5" height="9" fill="#3a3f45" /><rect x={G.front + 18.5} y={G.edge} width="12.5" height="9" fill="#3a3f45" />
    {parts.map((p) => <path d={p.d} fill={p.seal ? '#0a0b0c' : 'rgba(255,255,255,.1)'} stroke={p.seal ? '#7d838b' : '#e9eaec'} stroke-width={p.seal ? 0.25 : 0.45} stroke-linejoin="round" />)}
    <path d={`M${G.front - 4} ${gEnd}l6 -2.5 6 5 6 -5 6 5 6 -5 6 5 6 -2.5`} fill="none" stroke="#7d838b" stroke-width="0.4" />
    <g stroke="#ff7d00" stroke-width="0.4" fill="none">
      <path d="M0 -9H82.6M0 -12v6M82.6 -12v6" />
      <path d={`M-9 0V${G.sight}M-12 0h6M-12 ${G.sight}h6`} />
    </g>
    <g fill="#ff7d00" text-anchor="middle">
      <text x="41.3" y="-11.5">{Math.round(82.6 * 10) / 10} mm · {inch(82.6)}</text>
      <text x="-11.5" y={G.sight / 2} transform={`rotate(-90 -11.5 ${G.sight / 2})`}>{G.sight} mm · {inch(G.sight)}</text>
    </g>
    <g fill="#7d838b" font-size="3.6" letter-spacing="0.3">
      <text x="-24" y={gEnd + 9}>← {labels.ext.toUpperCase()}</text>
      <text x="106" y={gEnd + 9} text-anchor="end">{labels.int.toUpperCase()} →</text>
    </g>
    {marks.map((m) => <g><circle cx={m.x} cy={m.y} r="4" fill="#ff7d00" /><text x={m.x} y={m.y + 1.5} text-anchor="middle" fill="#140900" font-size="4.4" font-weight="500">{m.n}</text></g>)}
  </svg>
  <figcaption>
    <ol>{labels.parts.map((p) => <li>{p}</li>)}</ol>
  </figcaption>
</figure>
