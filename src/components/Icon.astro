---
// Thin line icons (24x24 viewBox, stroked by CSS).
interface Props { name: 'sun' | 'shield' | 'snow' | 'leaf' | 'ruler' | 'clock' | 'wrench' | 'home' | 'handshake' | 'quiet'; }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" stroke-linecap="round" stroke-linejoin="round">
  {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>}
  {name === 'shield' && <path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3zM9 12l2 2 4-4" />}
  {name === 'snow' && <path d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19M12 2l-2 2M12 2l2 2M12 22l-2-2M12 22l2-2M2 12l2-2M2 12l2 2M22 12l-2-2M22 12l-2 2" />}
  {name === 'leaf' && <path d="M4 20c0-9 5-14 16-16-1 11-6 16-14 16M4 20l8-8" />}
  {name === 'ruler' && <path d="M3 17L17 3l4 4L7 21zM7 13l2 2M10 10l2 2M13 7l2 2" />}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'wrench' && <path d="M14 7a4 4 0 0 1 5 5l-9 9-3-3 9-9a4 4 0 0 0-2-2zM3 21l3-3" />}
  {name === 'home' && <path d="M3 11l9-8 9 8v10H3zM9 21v-7h6v7" />}
  {name === 'handshake' && <path d="M2 10l4-4h5l3 3 2-2h4l2 2-6 6-2-2-3 3-4-4M2 10l5 5" />}
  {name === 'quiet' && <path d="M3 10v4h4l5 4V6l-5 4zM16 9a4 4 0 0 1 0 6M19 6a8 8 0 0 1 0 12" />}
</svg>
