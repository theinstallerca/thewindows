---
import Base from '../../layouts/Base.astro';
import WindowArt from '../WindowArt.astro';
import { t, type Lang } from '../../i18n';
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
// Drop photos into public/images/gallery/ and list them here.
// { src: '/images/gallery/filename.jpg', caption: { en: '...', uk: '...' } }
const photos: { src: string; w: number; h: number; caption: Record<Lang, string> }[] = [
  { src: '/images/gallery/casement-picture-grey-siding.webp', w: 1476, h: 1066, caption: { en: 'Casement and picture window', uk: 'Поворотне та глухе вікно' } },
  { src: '/images/gallery/picture-over-awning-stucco.webp', w: 1002, h: 1569, caption: { en: 'Picture window over an awning', uk: 'Глухе вікно над фрамугою' } },
  { src: '/images/gallery/casement-picture-casement-siding-brick.webp', w: 1522, h: 1033, caption: { en: 'Casement, picture, casement', uk: 'Поворотне, глухе, поворотне' } },
  { src: '/images/gallery/basement-awning-window-well.webp', w: 1567, h: 1004, caption: { en: 'Basement awning window', uk: 'Підвальне вікно-фрамуга' } },
  { src: '/images/gallery/split-level-house.webp', w: 1779, h: 884, caption: { en: 'Whole-house window replacement', uk: 'Заміна вікон у всьому будинку' } },
  { src: '/images/gallery/raised-bungalow.webp', w: 1536, h: 1024, caption: { en: 'Picture windows with casements, upstairs and down', uk: 'Глухі вікна з поворотними, на обох поверхах' } },
];
const z = s.estimate;
// Three balanced columns: each photo, in order, goes to whichever column is currently shortest
// (heights in column widths, plus a little for the caption), so no column is left with a gap.
const cols: { p: (typeof photos)[number]; i: number }[][] = [[], [], []];
const heights = [0, 0, 0];
photos.forEach((p, i) => { const c = heights.indexOf(Math.min(...heights)); cols[c].push({ p, i }); heights[c] += p.h / p.w + 0.12; });
const placeholders = ['hero', 'corner', 'handle', 'casement', 'awning', 'picture'] as const;
---
<Base title={s.gallery.title} lang={lang} path="/gallery">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1 class="center">{s.gallery.h1}</h1>
        <p>{s.gallery.lead}</p>
      </div>
      <div class={photos.length > 0 ? "gallery photos" : "gallery"}>
        {photos.length > 0
          ? cols.map((col) => (
              <div class="gcol">
                {col.map(({ p, i }) => (
                  <figure class="pv-zoomable" role="button" tabindex="0" title={z.zoomTip} data-i={i} data-src={p.src} data-w={p.w} data-h={p.h} data-cap={p.caption[lang]}>
                    <img src={p.src} alt={p.caption[lang]} loading="lazy" width={p.w} height={p.h} />
                    <figcaption>{p.caption[lang]}</figcaption>
                  </figure>
                ))}
              </div>
            ))
          : placeholders.map((k) => (
              <figure>
                <WindowArt kind={k} />
                <figcaption>{s.gallery.soon}</figcaption>
              </figure>
            ))}
      </div>
    </div>
  </section>

  {photos.length > 0 && (
    <div id="zoom" class="zoom" role="dialog" aria-modal="true" aria-label={s.gallery.h1} hidden>
      <div class="zoom-bar">
        <span class="zoom-title"></span>
        <span class="zoom-hint">{z.zoomHint}</span>
        <span class="zoom-btns">
          {photos.length > 1 && <button type="button" data-z="prev" aria-label={s.gallery.prev} title={s.gallery.prev}>←</button>}
          {photos.length > 1 && <button type="button" data-z="next" aria-label={s.gallery.next} title={s.gallery.next}>→</button>}
          <button type="button" data-z="out" aria-label={z.zoomOut} title={z.zoomOut}>&minus;</button>
          <button type="button" data-z="in" aria-label={z.zoomIn} title={z.zoomIn}>+</button>
          <button type="button" data-z="reset">{z.zoomReset}</button>
          <button type="button" data-z="close" class="zoom-close">{z.close}</button>
        </span>
      </div>
      <div class="zoom-view"><div class="zoom-pan"><div class="zoom-content zoom-photo"><img alt="" draggable="false" /></div></div></div>
    </div>
  )}

  <script>
    // Click a photo to open it large (see src/scripts/zoom.ts); arrows step through the gallery.
    import { createZoom } from '../../scripts/zoom';
    const zoomEl = document.getElementById('zoom');
    if (zoomEl) {
      // stepping follows the gallery's own order, not the order of the columns
      const figs = [...document.querySelectorAll<HTMLElement>('.gallery figure[data-src]')].sort((a, b) => +a.dataset.i! - +b.dataset.i!);
      const title = zoomEl.querySelector<HTMLElement>('.zoom-title')!;
      let at = 0;
      const d = (i: number) => figs[i].dataset;
      const label = (i: number) => { title.textContent = d(i).cap + (figs.length > 1 ? ` · ${i + 1} / ${figs.length}` : ''); };
      const z = createZoom(zoomEl, { onStep: (dir) => { at = (at + dir + figs.length) % figs.length; label(at); z.show(d(at).src!, +d(at).w!, +d(at).h!, d(at).cap); } });
      figs.forEach((f, i) => {
        const open = () => { at = i; label(i); z.open(d(i).src!, +d(i).w!, +d(i).h!, f, d(i).cap); };
        f.addEventListener('click', open);
        f.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); open(); } });
      });
    }
  </script>
</Base>
