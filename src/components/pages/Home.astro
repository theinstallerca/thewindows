---
import Base from '../../layouts/Base.astro';
import { t, link, typeSlug, type Lang } from '../../i18n';
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const h = s.home;
const featured = ['casement', 'awning', 'picture', 'fixed'] as const;

// Notes round the hero photo: which side the label sits on, where the dot is on the photo (% of its
// width and height), and how long the leader line is (% of the photo's width).
const notes = [
  { side: 'l', x: 38, y: 34, len: 45 },
  { side: 'l', x: 22, y: 62, len: 26 },
  { side: 'l', x: 5, y: 90, len: 12 },
  { side: 'r', x: 79, y: 24, len: 26 },
  { side: 'r', x: 88, y: 58, len: 16 },
  { side: 'r', x: 70, y: 87, len: 33 },
].map((n, i) => ({ ...n, text: h.notes[i] }));

// Dimension lines over the estimate picture, in the picture's own units (592 x 302.4). The numbers
// come from where the 80" x 32" frames sit in that render.
const D = { l: 79.6, r: 552.4, t: 54, b: 243, j1: 197.8, j2: 434.2, yTop: 22.2, yBot: 272.7, xLeft: 45.9 };
const hLine = (x1: number, x2: number, y: number) => `M${x1} ${y}H${x2}M${x1} ${y - 6}v12M${x2} ${y - 6}v12`;
---
<Base title={h.title} description={s.desc.home} lang={lang} path="/">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="mono">{h.kicker}</span>
        <h1><span>{h.h1[0]}</span><span>{h.h1[1]}</span></h1>
        <p class="lead">{h.lead}</p>
        <div class="hero-actions">
          <a href={link(lang, '/estimate')} class="btn btn-solid">{h.estimate}</a>
          <a href={link(lang, '/windows')} class="btn">{h.types}</a>
        </div>
        <ul class="hero-points">{h.points.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div>
        <div class="hero-stage">
          <div class="shot">
            <img src="/images/windows/casement-outside.webp" width="552" height="900" alt={h.photoAlt} fetchpriority="high" />
            {notes.map((n) => (
              <div class={`call ${n.side}`} style={`${n.side === 'r' ? `left:${n.x}%` : `right:${100 - n.x}%`};top:${n.y}%;--len:${n.len}`} aria-hidden="true">
                <i></i><u></u><span class="mono">{n.text}</span>
              </div>
            ))}
          </div>
        </div>
        <ul class="call-list">{h.notes.map((n) => <li class="mono">{n}</li>)}</ul>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="how" aria-label={h.howH}>
      <h2 class="mono how-h">{h.howH}</h2>
      <ol>
        {h.steps.map(([title, text], i) => (
          <li><b aria-hidden="true">0{i + 1}</b><div><h3>{title}</h3><p>{text}</p></div></li>
        ))}
      </ol>
    </section>

    <section class="panel est-tile">
      <div>
        <span class="kicker">{h.estKicker}</span>
        <h2>{h.estH}</h2>
        <p>{h.estP}</p>
        <a href={link(lang, '/estimate')} class="btn btn-solid">{h.estBtn} →</a>
      </div>
      <div class="est-shot">
        <img src="/images/home/estimate-preview.webp" width="1184" height="605" alt={h.estAlt} loading="lazy" />
        <svg viewBox="0 0 592 302.4" aria-hidden="true" fill="none" stroke="#ff7d00" stroke-width="1.4" font-family="JetBrains Mono, monospace" font-size="14" font-weight="500">
          <path d={hLine(D.l, D.r, D.yTop) + hLine(D.l, D.j1, D.yBot) + hLine(D.j1, D.j2, D.yBot) + hLine(D.j2, D.r, D.yBot) + `M${D.xLeft} ${D.t}V${D.b}M${D.xLeft - 6} ${D.t}h12M${D.xLeft - 6} ${D.b}h12`} />
          <g fill="#ff7d00" stroke="none" text-anchor="middle">
            <text x={(D.l + D.r) / 2} y={D.yTop - 7}>80"</text>
            <text x={(D.l + D.j1) / 2} y={D.yBot + 17}>20"</text>
            <text x={(D.j1 + D.j2) / 2} y={D.yBot + 17}>40"</text>
            <text x={(D.j2 + D.r) / 2} y={D.yBot + 17}>20"</text>
            <text x={D.xLeft - 9} y={(D.t + D.b) / 2} transform={`rotate(-90 ${D.xLeft - 9} ${(D.t + D.b) / 2})`}>32"</text>
          </g>
        </svg>
      </div>
    </section>

    <section>
      <div class="head-row">
        <h2>{h.typesH}</h2>
        <span class="mono">{h.typesNote}</span>
      </div>
      <div class="cards cards-4">
        {featured.map((k, i) => (
          <article class="card type-card">
            <div class="top">
              <svg viewBox="0 0 102 100" fill="none" stroke="#c9cdd2" aria-hidden="true">
                <rect x="2" y="2" width="98" height="96" stroke-width="2.5" />
                {k === 'fixed' ? <rect x="20" y="20" width="62" height="60" stroke-width="1.2" /> : <rect x="10" y="10" width="82" height="80" stroke-width="1.2" />}
                {k === 'casement' && <polyline points="88,14 14,50 88,86" stroke-width="1.5" />}
                {k === 'awning' && <polyline points="14,86 51,14 88,86" stroke-width="1.5" />}
              </svg>
              <span class="card-code">W-0{i + 1}</span>
            </div>
            <h3>{s.types[k][0]}</h3>
            <p>{h.typeShort[k]}</p>
            <a href={link(lang, typeSlug(k))} class="more">{h.more} →</a>
          </article>
        ))}
      </div>
    </section>
  </div>

  <section class="section">
    <div class="container split">
      <div class="media photo"><img src="/images/windows/casement-inside.webp" width="576" height="900" alt={h.detailsAlt} loading="lazy" /></div>
      <div>
        <h2>{h.detailsH}</h2>
        <p>{h.detailsP}</p>
        <ul class="checklist">
          {h.detailsList.map((x) => <li>{x}</li>)}
        </ul>
        <a href={link(lang, '/windows')} class="more">{h.detailsMore} →</a>
      </div>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="container">
      <h2>{h.ctaH}</h2>
      <p>{h.ctaP}</p>
      <a href={link(lang, '/contact')} class="btn">{h.quote}</a>
    </div>
  </section>
</Base>
