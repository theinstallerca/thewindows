---
// One page per window type: /casement-windows, /awning-windows, /picture-windows, /fixed-windows.
import Base from '../../layouts/Base.astro';
import ProfileSection from '../ProfileSection.astro';
import { t, link, typeSlug, type Lang } from '../../i18n';
type Kind = 'casement' | 'awning' | 'picture' | 'fixed';
const { lang, kind } = Astro.props as { lang: Lang; kind: Kind };
const s = t(lang);
const tp = s.typePages;
const p = tp[kind];
const kinds: Kind[] = ['casement', 'awning', 'picture', 'fixed'];
const img = { casement: [552, 900], awning: [547, 900], picture: [552, 900], fixed: [552, 900] }[kind];
const sashed = kind === 'casement' || kind === 'awning';
const sight = { casement: '77.8 mm · 3 1/16"', awning: '77.8 mm · 3 1/16"', picture: '41.6 mm · 1 5/8"', fixed: '77.6 mm · 3 1/16"' }[kind];
const specs = [[tp.specOpens, p.opens], [tp.specDepth, '82.6 mm · 3 1/4"'], [tp.specSight, sight], [tp.specGlass, tp.glassValue]];
const parts = sashed ? [tp.partFrame, tp.partSash, tp.partGlass, tp.partBead] : [tp.partFrame, tp.partGlass, tp.partBead];
---
<Base title={p.title} lang={lang} path={typeSlug(kind)}>
  <section class="hero type-hero">
    <div class="container hero-grid">
      <div>
        <span class="mono"><a href={link(lang, '/windows')}>{s.windows.h1}</a> / W-0{kinds.indexOf(kind) + 1}</span>
        <h1>{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <div class="hero-actions">
          <a href={link(lang, '/estimate')} class="btn btn-solid">{s.home.estimate}</a>
          <a href={link(lang, '/contact')} class="btn">{s.home.quote}</a>
        </div>
      </div>
      <div class="hero-stage"><div class="shot"><img src={`/images/windows/${kind}-outside.webp`} width={img[0]} height={img[1]} alt={`${s.types[kind][0]}: ${s.photo.outside}`} fetchpriority="high" /></div></div>
    </div>
  </section>

  <div class="container">
    <dl class="specs">
      {specs.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
    </dl>

    <section class="panel build">
      <div>
        <span class="kicker">{tp.buildKicker}</span>
        <h2>{tp.buildH}</h2>
        {p.build.map((x) => <p>{x}</p>)}
      </div>
      <ProfileSection kind={kind} labels={{ ext: tp.ext, int: tp.int, depth: `${tp.specDepth} 82.6 mm`, sight: `${tp.specSight} ${sight}`, parts }} />
    </section>

    <section class="type-cols">
      <div>
        <h2>{tp.fitsH}</h2>
        <ul class="checklist">{p.fits.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h2>{s.windows.glassH}</h2>
        <ul class="checklist">{s.windows.glass.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h2>{s.windows.frameH}</h2>
        <ul class="checklist">{s.windows.frame.map((x) => <li>{x}</li>)}</ul>
      </div>
    </section>

    <section>
      <div class="head-row"><h2>{tp.othersH}</h2><span class="mono">{s.home.typesNote}</span></div>
      <div class="cards">
        {kinds.filter((k) => k !== kind).map((k) => (
          <a class="card other" href={link(lang, typeSlug(k))}>
            <img src={`/images/windows/${k}-outside.webp`} alt="" loading="lazy" width="552" height="900" />
            <div><span class="card-code">W-0{kinds.indexOf(k) + 1}</span><h3>{s.types[k][0]}</h3><p>{s.home.typeShort[k]}</p></div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <section class="section cta-band" style="margin-top: 3.5rem; border-top: 1px solid var(--line);">
    <div class="container">
      <h2>{s.windows.ctaH}</h2>
      <p>{s.windows.ctaP}</p>
      <a href={link(lang, '/contact')} class="btn">{s.windows.ctaBtn}</a>
    </div>
  </section>
</Base>
