---
// One page per window type: /casement-windows, /awning-windows, /picture-windows, /fixed-windows.
import Base from '../../layouts/Base.astro';
import sections from '../../data/sections.json';
import { t, link, typeSlug, type Lang } from '../../i18n';
type Kind = 'casement' | 'awning' | 'picture' | 'fixed';
const { lang, kind } = Astro.props as { lang: Lang; kind: Kind };
const s = t(lang);
const tp = s.typePages;
const p = tp[kind];
const kinds: Kind[] = ['casement', 'awning', 'picture', 'fixed'];
const img = { casement: [552, 900], awning: [547, 900], picture: [552, 900], fixed: [552, 900] }[kind];
const sashed = kind === 'casement' || kind === 'awning';
const sight = { casement: '77.8 mm · 3 1/16"', awning: '77.8 mm · 3 1/16"', picture: '41.6 mm · 1 5/8"', fixed: '77.6 mm · 3 1/16"' }[kind];
const specs = [[tp.specOpens, p.opens], [tp.specDepth, '82.6 mm · 3 1/4"'], [tp.specSight, sight], [tp.specGlass, tp.glassValue]];
// An awning is the casement's frame and sash with the hinges at the top, so it shows the casement's section.
// The cut sections are renders of the real profiles, all at one scale; the marker positions (% of the
// picture) come from the render notes: frame, sash where there is one, glass unit, glazing bead,
// brickmould, its cap, jamb extension, and the screen on opening units.
const sec = (sections as Record<string, { w: number; h: number; marks: number[][] }>)[kind];
// the legend reads down the left column, then down the right
const rows = Math.ceil((sashed ? 8 : 6) / 2);
// A short looping animation under the text, where a type has one: an animated WebP with a transparent
// background (plays and loops by itself, no video player). Visitors who ask for reduced motion get its
// first frame instead.
const motions: Partial<Record<Kind, { anim?: string; poster: string; w: number; h: number; alt: string }>> = {
  casement: { anim: '/images/windows/casement-open-close.webp', poster: '/images/windows/casement-motion-poster.webp', w: 474, h: 720, alt: s.typePages.casementAnimAlt },
  awning: { anim: '/images/windows/awning-open-close.webp', poster: '/images/windows/awning-motion-poster.webp', w: 502, h: 720, alt: s.typePages.awningAnimAlt },
};
const motion = motions[kind];
const secKind = kind === 'awning' ? 'casement' : kind;
const z = s.estimate;
const trim = [tp.partBrickmould, tp.partCap, tp.partJamb];
const parts = sashed ? [tp.partFrame, tp.partSash, tp.partGlass, tp.partBead, ...trim, tp.partScreen] : [tp.partFrame, tp.partGlass, tp.partBead, ...trim];
---
<Base title={p.title} description={s.desc[kind]} lang={lang} crumbs={[[s.nav.windows, '/windows'], [p.h1, typeSlug(kind)]]} path={typeSlug(kind)}>
  <section class="hero type-hero">
    <div class="container hero-grid">
      <div>
        <span class="mono"><a href={link(lang, '/windows')}>{s.windows.h1}</a> / W-0{kinds.indexOf(kind) + 1}</span>
        <h1>{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <div class="hero-actions">
          <a href={link(lang, '/estimate')} class="btn btn-solid">{s.home.estimate}</a>
          <a href={link(lang, '/contact')} class="btn">{s.home.quote}</a>
        </div>
      </div>
      <div class="hero-stage"><div class="shot"><img src={`/images/windows/${kind}-outside.webp`} width={img[0]} height={img[1]} alt={`${s.types[kind][0]}: ${s.photo.outside}`} fetchpriority="high" /></div></div>
    </div>
  </section>

  <div class="container">
    <dl class="specs">
      {specs.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
    </dl>

    <section class="panel build">
      <div class={motion ? 'build-text has-motion' : 'build-text'}>
        <div>
          <span class="kicker">{tp.buildKicker}</span>
          <h2>{tp.buildH}</h2>
          {p.build.map((x) => <p>{x}</p>)}
        </div>
        {motion && (
          <div class="build-motion">
            <picture>
              {motion.anim && <source srcset={motion.poster} media="(prefers-reduced-motion: reduce)" />}
              <img src={motion.anim ?? motion.poster} width={motion.w} height={motion.h} alt={motion.alt} loading="lazy" decoding="async" />
            </picture>
          </div>
        )}
      </div>
      <figure class="psec">
        <div class="psec-shot pv-zoomable" id="sec-shot" role="button" tabindex="0" title={z.zoomTip} data-large={`/images/windows/${secKind}-section-large.webp`}>
          <img src={`/images/windows/${secKind}-section.webp`} width={sec.w} height={sec.h} alt={`${p.h1}: ${tp.buildKicker.toLowerCase()}`} loading="lazy" />
          {sec.marks.map(([x, y], i) => <b style={`left:${x}%;top:${y}%`} aria-hidden="true">{i + 1}</b>)}
        </div>
        <p class="pv-tip" style="text-align:center">{z.zoomTip}</p>
        <div class="psec-sides mono"><span>← {tp.ext}</span><span>{tp.int} →</span></div>
        <figcaption><ol style={`--rows:${rows}`}>{parts.map((x) => <li>{x}</li>)}</ol></figcaption>
      </figure>
    </section>

    <section class="type-cols">
      <div>
        <h2>{tp.fitsH}</h2>
        <ul class="checklist">{p.fits.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h2>{s.windows.glassH}</h2>
        <ul class="checklist">{s.windows.glass.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h2>{s.windows.frameH}</h2>
        <ul class="checklist">{s.windows.frame.map((x) => <li>{x}</li>)}</ul>
      </div>
    </section>

    <section>
      <div class="head-row"><h2>{tp.othersH}</h2><span class="mono">{s.home.typesNote}</span></div>
      <div class="cards">
        {kinds.filter((k) => k !== kind).map((k) => (
          <a class="card other" href={link(lang, typeSlug(k))}>
            <img src={`/images/windows/${k}-outside.webp`} alt="" loading="lazy" width="552" height="900" />
            <div><span class="card-code">W-0{kinds.indexOf(k) + 1}</span><h3>{s.types[k][0]}</h3><p>{s.home.typeShort[k]}</p></div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <div id="zoom" class="zoom" role="dialog" aria-modal="true" aria-label={tp.buildKicker} hidden>
    <div class="zoom-bar">
      <span class="zoom-title">{p.h1} · {tp.buildKicker}</span>
      <span class="zoom-hint">{z.zoomHint}</span>
      <span class="zoom-btns">
        <button type="button" data-z="out" aria-label={z.zoomOut} title={z.zoomOut}>&minus;</button>
        <button type="button" data-z="in" aria-label={z.zoomIn} title={z.zoomIn}>+</button>
        <button type="button" data-z="reset">{z.zoomReset}</button>
        <button type="button" data-z="close" class="zoom-close">{z.close}</button>
      </span>
    </div>
    <div class="zoom-view"><div class="zoom-pan"><div class="zoom-content zoom-sec">
      <img alt="" width={sec.w * 2} height={sec.h * 2} draggable="false" />
      {sec.marks.map(([x, y], i) => <b style={`left:${x}%;top:${y}%`} aria-hidden="true">{i + 1}</b>)}
    </div></div></div>
    <ol class="zoom-legend" style={`--rows:${rows}`}>{parts.map((x) => <li>{x}</li>)}</ol>
  </div>

  <script>
    // Enlarged section: click the picture to open it over the page (see src/scripts/zoom.ts).
    import { createZoom } from '../../scripts/zoom';
    const shot = document.getElementById('sec-shot')!;
    const zoomEl = document.getElementById('zoom')!;
    const big = zoomEl.querySelector('img')!;
    const z = createZoom(zoomEl);
    // the picture's size comes from its attributes: the rendered size is not known until it has loaded
    const open = () => z.open(shot.dataset.large!, Number(big.getAttribute('width')), Number(big.getAttribute('height')), shot);
    shot.addEventListener('click', open);
    shot.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); open(); } });
  </script>

  <section class="section cta-band" style="margin-top: 3.5rem; border-top: 1px solid var(--line);">
    <div class="container">
      <h2>{s.windows.ctaH}</h2>
      <p>{s.windows.ctaP}</p>
      <a href={link(lang, '/contact')} class="btn">{s.windows.ctaBtn}</a>
    </div>
  </section>
</Base>
