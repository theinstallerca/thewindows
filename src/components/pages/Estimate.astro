---
import Base from '../../layouts/Base.astro';
import { t, phone, email, type Lang } from '../../i18n';
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const e = s.estimate;
const v = e.v3;
// What the 3D preview offers — the same roofs, walls and frame colours as the Measure App.
const roofs = ['rooftan', 'roofbrown', 'roofgrey', 'roofcharcoal'];
const walls = [
  { label: v.brick, items: ['brick1', 'brick2', 'brick3'] },
  { label: v.siding, items: ['siding1', 'siding2', 'siding3', 'siding4', 'siding5', 'siding7', 'siding8'] },
];
const stuccos = ['#ecebe6', '#e3d9c3', '#d4c4a8', '#c9b28f', '#b9b8b2', '#a89f93', '#8e8377', '#5d5f61'];
const colors = ['#f4f5f3', '#e9dfc8', '#c9b79a', '#4a3b32', '#26282b'];
---
<Base title={e.title} lang={lang} path="/estimate">
  <section class="section est">
    <div class="container">
      <div class="section-head">
        <h1 class="center">{e.h1}</h1>
        <p>{e.lead}</p>
      </div>

      <div id="form-ok" class="alert alert-ok" hidden>{e.ok}</div>
      <div id="form-err" class="alert alert-err" hidden>{e.err}</div>

      <form id="est-form" class="est-form" action="/api/estimate.php" method="post" novalidate>
        <input type="hidden" name="lang" value={lang} />
        <div class="est-toolbar">
          <span class="est-unit">
            <label>{e.unit}</label>
            <span class="seg">
              <input type="radio" name="unit" id="u-in" value="in" checked /><label for="u-in">{e.inch}</label>
              <input type="radio" name="unit" id="u-cm" value="cm" /><label for="u-cm">{e.cm}</label>
            </span>
          </span>
        </div>

        <div id="windows"></div>
        <button type="button" id="add" class="btn">{e.add}</button>

        <div class="est-details">
          <h2 class="left">{e.yourDetails}</h2>
          <div class="form">
            <div class="form-row">
              <div><label for="name">{s.contact.name}</label><input id="name" name="name" required autocomplete="name" /></div>
              <div><label for="email">{s.contact.email}</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
            </div>
            <div><label for="notes">{e.notes}</label><textarea id="notes" name="notes" rows="4" placeholder={e.notesPh}></textarea></div>
            <div class="hp" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
            <div><button type="submit" class="btn btn-solid">{e.send}</button></div>
            <p class="form-note">{e.note}</p>
          </div>
        </div>
      </form>
    </div>
  </section>

  <div id="zoom" class="zoom" role="dialog" aria-modal="true" aria-label={e.tab2d} hidden>
    <div class="zoom-bar">
      <span class="zoom-title"></span>
      <span class="zoom-hint">{e.zoomHint}</span>
      <span class="zoom-btns">
        <button type="button" data-z="out" aria-label={e.zoomOut} title={e.zoomOut}>&minus;</button>
        <button type="button" data-z="in" aria-label={e.zoomIn} title={e.zoomIn}>+</button>
        <button type="button" data-z="reset">{e.zoomReset}</button>
        <button type="button" data-z="close" class="zoom-close">{e.close}</button>
      </span>
    </div>
    <div class="zoom-view"><div class="zoom-pan"><div class="zoom-content"></div></div></div>
  </div>

  <template id="win-tpl">
    <article class="win">
      <header class="win-head">
        <h3><span class="win-badge" aria-hidden="true"></span><span class="win-title">{e.window}</span> <span class="win-n"></span></h3>
        <button type="button" class="win-remove more">{e.remove}</button>
      </header>
      <div class="win-grid">
        <div class="win-fields">
          <div class="grp">
          <h4 class="grp-h"><span>1</span>{e.grpSize}</h4>
          <div class="form-row form-row-3">
            <div><label>{e.width} <span class="u"></span></label><input class="f-w" type="number" min="1" step="any" inputmode="decimal" /></div>
            <div><label>{e.height} <span class="u"></span></label><input class="f-h" type="number" min="1" step="any" inputmode="decimal" /></div>
            <div><label>{e.qty}</label><input class="f-qty" type="number" min="1" value="1" /></div>
          </div>
          </div>
          <div class="grp">
          <h4 class="grp-h"><span>2</span>{e.grpUnits}</h4>
          <div class="grp-line">
            <label>{e.grpUnitsQ}</label>
            <span class="seg seg-sec">
              <input type="radio" class="f-sec" value="1" checked /><label>1</label>
              <input type="radio" class="f-sec" value="2" /><label>2</label>
              <input type="radio" class="f-sec" value="3" /><label>3</label>
            </span>
          </div>
          <div class="sec-types">
            {[0, 1, 2].map((i) => (
              <div class="sec-row">
                <div><label>{e.section} {i + 1}</label><select class="f-t" data-i={i}></select></div>
                <div class="sec-w"><label>{e.width} <span class="u"></span></label><input class="f-uw" data-i={i} type="number" min="0" step="any" inputmode="decimal" aria-label={`${e.section} ${i + 1}: ${e.width}`} /></div>
              </div>
            ))}
            <p class="sec-hint">{e.unitWidthHint}</p>
            <p class="sec-warn" hidden>{e.unitWidthWarn}</p>
          </div>
          </div>
          <div class="grp">
          <h4 class="grp-h"><span>3</span>{e.grpOptions}</h4>
          <div class="form-row">
            <div>
              <label>{e.wall}</label>
              <select class="f-wall">
                <option value="">{e.wallNone}</option>
                <option value="4-1/2">4-1/2"</option>
                <option value="5-1/4">5-1/4"</option>
                <option value="6-1/2">6-1/2"</option>
                <option value="custom">{e.wallCustom}</option>
              </select>
            </div>
            <div class="wall-custom" hidden><label>{e.wallCustomLabel}</label><input class="f-wallc" placeholder={e.wallCustomPh} /></div>
          </div>
          <div>
            <label>{e.glass}</label>
            <div class="checks">
              <span class="seg">
                <input type="radio" class="f-glass" value="dual" /><label>{e.dual}</label>
                <input type="radio" class="f-glass" value="triple" checked /><label>{e.triple}</label>
              </span>
              <label class="chk"><input type="checkbox" class="f-lowe" checked /> {e.lowe}</label>
              <label class="chk"><input type="checkbox" class="f-argon" checked /> {e.argon}</label>
            </div>
          </div>
          </div>
        </div>
        <div class="win-preview">
          <div class="pv-head">
            <div class="pv-tabs" role="tablist">
              <button type="button" class="pv-tab on" role="tab" aria-selected="true" data-view="2d">{e.tab2d}</button>
              <button type="button" class="pv-tab" role="tab" aria-selected="false" data-view="3d">{e.tab3d}</button>
            </div>
            <span class="pv-note">{e.outside}</span>
          </div>
          <div class="draw pv-zoomable" role="tabpanel" tabindex="0" title={e.zoomTip}></div>
          <div class="draw3d" role="tabpanel" hidden>
            <div class="v3-host pv-zoomable" tabindex="0" title={e.zoomTip}></div>
            <div class="v3-opts">
              <div class="v3-opt">
                <span class="v3-h">{v.roof}</span>
                <div class="v3-sw">
                  {roofs.map((r, i) => <button type="button" class="v3-s" data-roof={r} title={v.roofs[i]} aria-label={`${v.roof}: ${v.roofs[i]}`} style={`background-image:url(/tex/${r}.webp)`}></button>)}
                </div>
              </div>
              {walls.map((g) => (
                <div class="v3-opt">
                  <span class="v3-h">{g.label}</span>
                  <div class="v3-sw">
                    {g.items.map((w, i) => <button type="button" class="v3-s" data-wall={w} aria-label={`${g.label} ${i + 1}`} style={`background-image:url(/tex/${w}.webp)`}></button>)}
                  </div>
                </div>
              ))}
              <div class="v3-opt">
                <span class="v3-h">{v.stucco}</span>
                <div class="v3-sw">
                  {stuccos.map((c, i) => <button type="button" class="v3-s" data-wall="stucco" data-stucco={c} title={v.stuccos[i]} aria-label={`${v.stucco}: ${v.stuccos[i]}`} style={`background:url(/tex/stucco.webp) center/120px,${c};background-blend-mode:hard-light`}></button>)}
                </div>
              </div>
              <div class="v3-opt">
                <span class="v3-h">{v.color}</span>
                <div class="v3-sw">
                  {colors.map((c, i) => <button type="button" class="v3-s" data-color={c} title={v.colors[i]} aria-label={`${v.color}: ${v.colors[i]}`} style={`background:${c}`}></button>)}
                </div>
              </div>
              <p class="v3-note">{v.note}</p>
            </div>
          </div>
          <p class="pv-tip">{e.zoomTip}</p>
        </div>
      </div>
    </article>
  </template>

  <script is:inline src="/preview3d.js"></script>
  <script define:vars={{ types: e.types, needOne: e.needOne, unitWidthWarn: e.unitWidthWarn, building: v.building, unitLabels: { in: '"', cm: 'cm' } }}>
    const form = document.getElementById('est-form');
    const list = document.getElementById('windows');
    const tpl = document.getElementById('win-tpl');
    const ok = document.getElementById('form-ok');
    const err = document.getElementById('form-err');
    const typeKeys = ['none', 'casementL', 'casementR', 'awning', 'picture'];
    let n = 0;
    const loadedAt = Date.now();

    function unit() { return form.querySelector('input[name=unit]:checked').value; }
    function fmt(v) {
      if (!v) return '';
      if (unit() === 'cm') return Math.round(v * 10) / 10 + ' cm';
      // inches: show nearest 1/8 as fraction
      const whole = Math.floor(v), frac = v - whole, eighths = Math.round(frac * 8);
      if (eighths === 0) return whole + '"';
      if (eighths === 8) return (whole + 1) + '"';
      const g = (a, b) => b ? g(b, a % b) : a; const d = g(eighths, 8);
      return (whole ? whole + ' ' : '') + (eighths / d) + '/' + (8 / d) + '"';
    }

    function readWin(el) {
      const secN = +el.querySelector('.f-sec:checked').value;
      const types = [...el.querySelectorAll('.f-t')].slice(0, secN).map((s) => s.value);
      // Unit widths: the ones typed in are kept, the blank ones share what is left of the overall width.
      const typed = [...el.querySelectorAll('.f-uw')].slice(0, secN).map((i) => Math.max(0, +i.value || 0));
      const sum = typed.reduce((a, b) => a + b, 0), blanks = typed.filter((v) => !v).length;
      let w = +el.querySelector('.f-w').value || 0;
      if (!w && secN > 1 && !blanks) w = sum;                 // no overall width yet: the units add up to it
      const total = w || 36;                                   // 36 is what the drawing uses until a width is entered
      let widths, uwBad = false;
      if (secN === 1 || !sum) widths = typed.map(() => total / secN);
      else if (blanks && sum < total) widths = typed.map((v) => v || (total - sum) / blanks);
      else if (!blanks && Math.abs(sum - total) < 0.02) widths = typed;
      else { uwBad = !!w; widths = blanks ? typed.map(() => total / secN) : typed.map((v) => v * total / sum); }
      return {
        qty: +el.querySelector('.f-qty').value || 1,
        w, widths, uwBad, uwTyped: typed,
        h: +el.querySelector('.f-h').value || 0,
        sections: secN, types,
        wall: (() => { const v = el.querySelector('.f-wall').value; return v === 'custom' ? 'custom: ' + el.querySelector('.f-wallc').value.trim() : v; })(),
        glass: el.querySelector('.f-glass:checked').value,
        lowe: el.querySelector('.f-lowe').checked,
        argon: el.querySelector('.f-argon').checked,
      };
    }

    // Draws the window like the shop's fabrication sheet: frame, sections, LH/RH/AWN/PIC symbols, dimension lines.
    function svgFor(d) {
      const W = 560, H = 420, pad = { l: 70, r: 30, t: 50, b: 40 };
      const aw = W - pad.l - pad.r, ah = H - pad.t - pad.b;
      const w = d.w || 36, h = d.h || 36;
      const sc = Math.min(aw / w, ah / h);
      const fw = w * sc, fh = h * sc;
      const x0 = pad.l + (aw - fw) / 2, y0 = pad.t + (ah - fh) / 2;
      const fr = Math.max(6, Math.min(14, fw * 0.035)); // frame thickness px
      const ink = '#1c1c1c', dim = '#1f5fbf', glass = '#e9f0f7';
      let o = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" font-family="Poppins, Montserrat, Arial, sans-serif" font-size="13">`;
      o += `<rect width="${W}" height="${H}" fill="#fff"/>`;
      o += `<rect x="${x0}" y="${y0}" width="${fw}" height="${fh}" fill="${glass}" stroke="${ink}" stroke-width="2"/>`;
      o += `<rect x="${x0 + fr}" y="${y0 + fr}" width="${fw - 2 * fr}" height="${fh - 2 * fr}" fill="none" stroke="${ink}" stroke-width="1"/>`;
      const tw = d.widths.reduce((a, b) => a + b, 0);
      const sws = d.widths.map((v) => (fw - 2 * fr) * v / tw);
      const labels = { casementL: 'LH', casementR: 'RH', awning: 'AWN', picture: 'PIC', none: '' };
      for (let i = 0; i < d.sections; i++) {
        const sw = sws[i], sx = x0 + fr + sws.slice(0, i).reduce((a, b) => a + b, 0), sy = y0 + fr, sh = fh - 2 * fr;
        if (i > 0) o += `<line x1="${sx}" y1="${sy}" x2="${sx}" y2="${sy + sh}" stroke="${ink}" stroke-width="2"/>`;
        const t = d.types[i] || 'none';
        const m = Math.min(10, sw * 0.08);
        const ix = sx + m, iy = sy + m, iw = sw - 2 * m, ih = sh - 2 * m;
        if (t === 'casementL' || t === 'casementR' || t === 'awning') {
          o += `<rect x="${ix}" y="${iy}" width="${iw}" height="${ih}" fill="none" stroke="${ink}" stroke-width="1.2"/>`;
          // V points toward the hinge side, like the shop drawing
          let pts;
          if (t === 'casementL') pts = `${ix + iw},${iy} ${ix},${iy + ih / 2} ${ix + iw},${iy + ih}`;
          else if (t === 'casementR') pts = `${ix},${iy} ${ix + iw},${iy + ih / 2} ${ix},${iy + ih}`;
          else pts = `${ix},${iy + ih} ${ix + iw / 2},${iy} ${ix + iw},${iy + ih}`;
          o += `<polyline points="${pts}" fill="none" stroke="${ink}" stroke-width="1.2"/>`;
        }
        if (t === 'picture') o += `<rect x="${ix}" y="${iy}" width="${iw}" height="${ih}" fill="none" stroke="${ink}" stroke-width="1.2" stroke-dasharray="0"/>`;
        if (labels[t]) o += `<text x="${sx + sw / 2}" y="${sy + sh / 2 + 5}" text-anchor="middle" fill="${ink}" font-size="14">${labels[t]}</text>`;
        // section width dimension (only when >1 section)
        if (d.sections > 1 && d.w) {
          const yd = y0 - 14;
          o += `<line x1="${sx}" y1="${yd}" x2="${sx + sw}" y2="${yd}" stroke="${dim}" stroke-width="1" marker-start="url(#a)" marker-end="url(#a)"/>`;
          o += `<text x="${sx + sw / 2}" y="${yd - 4}" text-anchor="middle" fill="${dim}" font-size="11">${fmt(d.widths[i])}</text>`;
        }
      }
      o = o.replace('<rect width', `<defs><marker id="a" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,5 L10,2 L10,8 z" fill="${dim}"/></marker></defs><rect width`);
      // overall width (top) and height (left)
      if (d.w) {
        const yd = y0 - (d.sections > 1 ? 34 : 16);
        o += `<line x1="${x0}" y1="${yd}" x2="${x0 + fw}" y2="${yd}" stroke="${dim}" stroke-width="1"/>`;
        o += `<line x1="${x0}" y1="${yd - 5}" x2="${x0}" y2="${y0}" stroke="${dim}" stroke-width="0.6"/><line x1="${x0 + fw}" y1="${yd - 5}" x2="${x0 + fw}" y2="${y0}" stroke="${dim}" stroke-width="0.6"/>`;
        o += `<text x="${x0 + fw / 2}" y="${yd - 4}" text-anchor="middle" fill="${dim}" font-size="12">${fmt(d.w)}</text>`;
      }
      if (d.h) {
        const xd = x0 - 22;
        o += `<line x1="${xd}" y1="${y0}" x2="${xd}" y2="${y0 + fh}" stroke="${dim}" stroke-width="1"/>`;
        o += `<line x1="${xd - 5}" y1="${y0}" x2="${x0}" y2="${y0}" stroke="${dim}" stroke-width="0.6"/><line x1="${xd - 5}" y1="${y0 + fh}" x2="${x0}" y2="${y0 + fh}" stroke="${dim}" stroke-width="0.6"/>`;
        o += `<text x="${xd - 6}" y="${y0 + fh / 2}" text-anchor="middle" fill="${dim}" font-size="12" transform="rotate(-90 ${xd - 6} ${y0 + fh / 2})">${fmt(d.h)}</text>`;
      }
      o += `<text x="${W - 8}" y="${H - 8}" text-anchor="end" fill="#999" font-size="10">thewindows.ca</text>`;
      return o + '</svg>';
    }

    // 3D preview: the roof, wall and frame colour are one choice for the whole page — every window is going into the same house.
    const v3 = { roof: 'rooftan', wall: 'brick1', stucco: '#ecebe6', color: '#f4f5f3' };
    try { Object.assign(v3, JSON.parse(localStorage.getItem('est3d') || '{}')); } catch {}
    function syncOpts(root) {
      root.querySelectorAll('.v3-s').forEach((b) => {
        const ds = b.dataset;
        const on = ds.roof ? ds.roof === v3.roof
          : ds.color ? ds.color === v3.color
          : ds.wall === v3.wall && (ds.wall !== 'stucco' || ds.stucco === v3.stucco);
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', on);
      });
    }
    function win3d(el) {
      const d = readWin(el);
      const mm = unit() === 'cm' ? 10 : 25.4;
      const W = (d.w || 36) * mm, H = (d.h || 36) * mm;
      let x = 0;
      const units = d.types.map((t, i) => { const u = { x, y: 0, w: d.widths[i] * mm, h: H, sash: t === 'casementL' || t === 'casementR' || t === 'awning' }; x += u.w; return u; });
      return { W, H, units };
    }
    function draw3d(el) {
      if (el.dataset.view !== '3d' || !window.Preview3D) return;
      window.Preview3D.render(el.querySelector('.v3-host'), win3d(el), v3, building);
    }

    // Enlarged view: click a preview to open it over the page; wheel or pinch zooms, drag moves.
    const zoom = document.getElementById('zoom');
    const zView = zoom.querySelector('.zoom-view'), zPan = zoom.querySelector('.zoom-pan'), zContent = zoom.querySelector('.zoom-content');
    const Z = { el: null, view: '2d', s: 1, x: 0, y: 0, from: null };
    const Z_MAX = 8;
    function zApply() { zPan.style.transform = `translate(${Z.x}px,${Z.y}px) scale(${Z.s})`; }
    // zoom to scale ns, keeping the point under (cx, cy) where it is
    function zoomAt(ns, cx, cy) {
      ns = Math.max(1, Math.min(Z_MAX, ns));
      const r = zView.getBoundingClientRect();
      const px = (cx ?? r.left + r.width / 2) - r.left - zPan.offsetLeft, py = (cy ?? r.top + r.height / 2) - r.top - zPan.offsetTop;
      Z.x = px - (px - Z.x) * (ns / Z.s); Z.y = py - (py - Z.y) * (ns / Z.s); Z.s = ns;
      if (ns === 1) Z.x = Z.y = 0;
      zApply();
    }
    function zLayout() {
      // as large as fits, at the shape the picture has
      const ratio = Z.view === '3d' ? 0.8 : 420 / 560;
      const w = Math.floor(Math.min(zView.clientWidth - 24, (zView.clientHeight - 24) / ratio));
      zContent.style.width = w + 'px';
      zContent.style.height = Math.round(w * ratio) + 'px';
      Z.s = 1; Z.x = Z.y = 0; zApply();
      if (Z.view === '3d') { zContent.innerHTML = ''; window.Preview3D.render(zContent, win3d(Z.el), v3, building); }
      else zContent.innerHTML = svgFor(readWin(Z.el));
    }
    function openZoom(el, view, from) {
      Z.el = el; Z.view = view; Z.from = from;
      zoom.querySelector('.zoom-title').textContent = el.querySelector('.win-head h3').textContent.trim().replace(/\s+/g, ' ') + ' · ' + el.querySelector('.pv-tab.on').textContent;
      zoom.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      zLayout();
      zoom.querySelector('.zoom-close').focus();
    }
    function closeZoom() {
      zoom.hidden = true; zContent.innerHTML = '';
      document.documentElement.style.overflow = '';
      if (Z.from) Z.from.focus({ preventScroll: true });
      Z.el = null;
    }
    zoom.querySelector('.zoom-btns').addEventListener('click', (ev) => {
      const b = ev.target.closest('button'); if (!b) return;
      const a = b.dataset.z;
      if (a === 'close') closeZoom(); else if (a === 'reset') zoomAt(1); else zoomAt(Z.s * (a === 'in' ? 1.5 : 1 / 1.5));
    });
    zView.addEventListener('wheel', (ev) => { ev.preventDefault(); zoomAt(Z.s * Math.exp(-ev.deltaY * (ev.deltaMode ? 0.05 : 0.0015)), ev.clientX, ev.clientY); }, { passive: false });
    zView.addEventListener('dblclick', (ev) => zoomAt(Z.s > 1 ? 1 : 2.5, ev.clientX, ev.clientY));
    const pts = new Map(); let pinch = 0, moved = false, downOnBg = false;
    zView.addEventListener('pointerdown', (ev) => {
      if (ev.pointerType === 'mouse' && ev.button !== 0) return;
      zView.setPointerCapture(ev.pointerId);
      pts.set(ev.pointerId, { x: ev.clientX, y: ev.clientY });
      moved = false; downOnBg = ev.target === zView;
      if (pts.size === 2) { const [a, b] = [...pts.values()]; pinch = Math.hypot(a.x - b.x, a.y - b.y); }
      zView.classList.add('grabbing');
    });
    zView.addEventListener('pointermove', (ev) => {
      const p = pts.get(ev.pointerId); if (!p) return;
      const dx = ev.clientX - p.x, dy = ev.clientY - p.y;
      p.x = ev.clientX; p.y = ev.clientY;
      if (Math.abs(dx) + Math.abs(dy) > 2) moved = true;
      if (pts.size === 1) { Z.x += dx; Z.y += dy; zApply(); }
      else if (pts.size === 2) {
        const [a, b] = [...pts.values()], dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinch) zoomAt(Z.s * dist / pinch, (a.x + b.x) / 2, (a.y + b.y) / 2);
        pinch = dist;
      }
    });
    const zUp = (ev) => {
      if (!pts.delete(ev.pointerId)) return;
      pinch = 0;
      if (!pts.size) { zView.classList.remove('grabbing'); if (downOnBg && !moved && ev.type === 'pointerup') closeZoom(); }
    };
    zView.addEventListener('pointerup', zUp); zView.addEventListener('pointercancel', zUp);
    document.addEventListener('keydown', (ev) => {
      if (zoom.hidden) return;
      if (ev.key === 'Escape') closeZoom();
      else if (ev.key === '+' || ev.key === '=') zoomAt(Z.s * 1.5);
      else if (ev.key === '-') zoomAt(Z.s / 1.5);
      else if (ev.key === '0') zoomAt(1);
    });
    window.addEventListener('resize', () => { if (!zoom.hidden) zLayout(); });
    function setView(el, view) {
      el.dataset.view = view;
      el.querySelectorAll('.pv-tab').forEach((b) => { const on = b.dataset.view === view; b.classList.toggle('on', on); b.setAttribute('aria-selected', on); });
      el.querySelector('.draw').hidden = view !== '2d';
      el.querySelector('.draw3d').hidden = view !== '3d';
      draw3d(el);
    }

    function render(el) {
      const d = readWin(el);
      el.querySelector('.draw').innerHTML = svgFor(d);
      draw3d(el);
      el.querySelectorAll('.sec-row').forEach((div, i) => (div.hidden = i >= d.sections));
      // a lone unit is the whole window, so its width is the overall width
      el.querySelector('.sec-types').classList.toggle('one', d.sections === 1);
      el.querySelectorAll('.f-uw').forEach((inp, i) => { inp.placeholder = i < d.sections && d.w ? String(Math.round(d.widths[i] * 100) / 100) : ''; });
      el.querySelector('.sec-warn').hidden = !d.uwBad;
      el.querySelectorAll('.u').forEach((u) => (u.textContent = unit() === 'in' ? '(in)' : '(cm)'));
      el.querySelector('.wall-custom').hidden = el.querySelector('.f-wall').value !== 'custom';
    }

    function addWin() {
      const el = tpl.content.firstElementChild.cloneNode(true);
      n++;
      el.querySelector('.win-n').textContent = n;
      const grp = 'sec' + n, grpG = 'glass' + n;
      el.querySelectorAll('.f-sec').forEach((r, i) => { r.name = grp; r.id = grp + i; r.nextElementSibling.htmlFor = r.id; });
      el.querySelectorAll('.f-glass').forEach((r, i) => { r.name = grpG; r.id = grpG + i; r.nextElementSibling.htmlFor = r.id; });
      el.querySelectorAll('.f-t').forEach((sel, i) => {
        typeKeys.forEach((k) => { const o = document.createElement('option'); o.value = k; o.textContent = types[k]; sel.appendChild(o); });
        sel.value = 'none';
      });
      el.querySelector('.win-remove').addEventListener('click', () => { el.remove(); renumber(); });
      el.dataset.view = '2d';
      el.querySelectorAll('.pv-tab').forEach((b) => b.addEventListener('click', () => setView(el, b.dataset.view)));
      el.querySelector('.v3-opts').addEventListener('click', (ev) => {
        const b = ev.target.closest('.v3-s'); if (!b) return;
        const ds = b.dataset;
        if (ds.roof) v3.roof = ds.roof;
        else if (ds.color) v3.color = ds.color;
        else { v3.wall = ds.wall; if (ds.stucco) v3.stucco = ds.stucco; }
        try { localStorage.setItem('est3d', JSON.stringify(v3)); } catch {}
        syncOpts(list);
        [...list.children].forEach(draw3d);
      });
      syncOpts(el);
      el.querySelectorAll('.pv-zoomable').forEach((z) => {
        const go = () => openZoom(el, el.dataset.view, z);
        z.addEventListener('click', go);
        z.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); go(); } });
      });
      el.addEventListener('input', () => render(el));
      el.addEventListener('change', () => render(el));
      list.appendChild(el);
      render(el);
      renumber();
      return el;
    }
    function renumber() { [...list.children].forEach((el, i) => { el.querySelector('.win-n').textContent = i + 1; el.querySelector('.win-badge').textContent = i + 1; el.querySelector('.win-remove').hidden = i === 0; }); n = list.children.length; }
    function renderAll() { [...list.children].forEach(render); }

    document.getElementById('add').addEventListener('click', () => addWin().scrollIntoView({ behavior: 'smooth', block: 'center' }));
    form.querySelectorAll('input[name=unit]').forEach((r) => r.addEventListener('change', renderAll));
    // the 3D scene is laid out in pixels for the width it has, so it is rebuilt when that changes
    let lastW = window.innerWidth;
    window.addEventListener('resize', () => { if (window.innerWidth === lastW) return; lastW = window.innerWidth; [...list.children].forEach(draw3d); });
    addWin();

    function svgToPng(svg, w, h) {
      return new Promise((res) => {
        const img = new Image();
        const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
        img.onload = () => {
          const c = document.createElement('canvas'); c.width = w * 2; c.height = h * 2;
          const ctx = c.getContext('2d'); ctx.scale(2, 2); ctx.drawImage(img, 0, 0);
          URL.revokeObjectURL(url);
          c.toBlob((b) => res(b), 'image/png');
        };
        img.onerror = () => res(null);
        img.src = url;
      });
    }

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      ok.hidden = err.hidden = true;
      const wins = [...list.children].map(readWin).filter((d) => d.w > 0 && d.h > 0);
      if (!wins.length) { alert(needOne); return; }
      // widths that do not add up would reach the office as numbers the customer never typed
      const bad = [...list.children].find((el) => { const d = readWin(el); return d.w > 0 && d.h > 0 && d.uwBad; });
      if (bad) { bad.querySelector('.sec-warn').scrollIntoView({ behavior: 'smooth', block: 'center' }); alert(unitWidthWarn); return; }
      if (!form.name.value.trim() || !form.email.checkValidity()) { form.reportValidity(); return; }
      const btn = form.querySelector('button[type=submit]'); btn.disabled = true;
      const fd = new FormData();
      ['lang', 'name', 'email', 'notes', 'website'].forEach((k) => fd.append(k, form.elements[k].value));
      fd.append('ts', String(loadedAt));
      fd.append('unit', unit());
      fd.append('windows', JSON.stringify(wins.map(({ uwBad, uwTyped, ...d }) => ({ ...d, w_text: fmt(d.w), h_text: fmt(d.h), unit_w_text: d.sections > 1 ? d.widths.map(fmt) : [] }))));
      for (let i = 0; i < wins.length; i++) {
        const png = await svgToPng(svgFor(wins[i]), 560, 420);
        if (png) fd.append('preview[]', png, `window-${i + 1}.png`);
      }
      try {
        const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json', 'X-Requested-With': 'thewindows' } });
        const data = await res.json();
        if (res.ok && data.ok) { ok.hidden = false; form.reset(); list.innerHTML = ''; n = 0; addWin(); }
        else err.hidden = false;
      } catch { err.hidden = false; }
      btn.disabled = false;
      (ok.hidden ? err : ok).scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  </script>
</Base>
