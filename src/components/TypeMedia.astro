---
// The picture for a window type: product photos where we have them, the drawn placeholder otherwise.
// Pictures are cut-outs on a transparent background in public/images/windows/.
import WindowArt from './WindowArt.astro';
import { t, type Lang } from '../i18n';
interface Props { kind: string; lang: Lang; }
const { kind, lang } = Astro.props;
const s = t(lang);
const shot = (file: string, w: number, h: number, name: string) => ({ src: `/images/windows/${file}.webp`, w, h, alt: `${name}: ${s.photo.outside}` });
// Casement and awning are finished pictures; picture and fixed are rendered from the same Praxis profiles the 3D preview uses,
// at the casement's size (28" x 44") and on the same canvas, so all four show at the same scale.
const photos: Record<string, { src: string; w: number; h: number; alt: string }[]> = {
  casement: [shot('casement-outside', 552, 900, s.types.casement[0])],
  awning: [shot('awning-outside', 547, 900, s.types.awning[0])],
  picture: [shot('picture-outside', 552, 900, s.types.picture[0])],
  fixed: [shot('fixed-outside', 552, 900, s.types.fixed[0])],
};
const shots = photos[kind];
---
{shots ? (
  <div class="media shots">
    {shots.map((p) => <img src={p.src} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" />)}
  </div>
) : (
  <div class="media"><WindowArt kind={kind as any} /></div>
)}
