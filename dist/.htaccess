RewriteEngine On

# One host: www.thewindows.ca -> thewindows.ca (301, permanent), keeping the path.
RewriteCond %{HTTP_HOST} ^www\.thewindows\.ca$ [NC]
RewriteRule ^(.*)$ https://thewindows.ca/$1 [R=301,L]

# Extra domains, once each is added in cPanel as an alias of thewindows.ca (they do nothing until then).
# vikna.ca ("windows" in Ukrainian): the Ukrainian site, permanently.
RewriteCond %{HTTP_HOST} ^(www\.)?vikna\.ca$ [NC]
RewriteRule ^ https://thewindows.ca/ua/ [R=301,L]
# dveri.ca ("doors") and winnipegdoors.ca: no doors pages yet, so the contact page in the matching language.
# Temporary (302) on purpose: browsers do not remember it, so it can point at the doors pages later.
RewriteCond %{HTTP_HOST} ^(www\.)?dveri\.ca$ [NC]
RewriteRule ^ https://thewindows.ca/ua/contact [R=302,L]
RewriteCond %{HTTP_HOST} ^(www\.)?winnipegdoors\.ca$ [NC]
RewriteRule ^ https://thewindows.ca/contact [R=302,L]

# One address per page: /about.html -> /about, /index.html and /ua/index -> the folder (301, permanent).
# THE_REQUEST is the address the visitor typed, so the internal rewrite below cannot loop back here.
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index(?:\.html)?[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
# (Google's site-verification files must load as they are, so they are left alone.)
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$ [NC]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve /about as about.html, etc.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# HTML must always be revalidated; hashed assets can be cached long
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
